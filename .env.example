# Run `pnpm setup:env` to create .env with fresh, local-only secrets.
DJANGO_SECRET_KEY=replace-with-generated-local-secret
POSTGRES_DB=quick_commerce
POSTGRES_USER=quick_commerce
POSTGRES_PASSWORD=replace-with-generated-local-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-generated-local-secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Production also requires explicit hosts and HTTPS origins; see docs/deployment.md.
# DJANGO_ALLOWED_HOSTS=commerce.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://commerce.example.com
# Production private verification storage (required; use a secret manager):
# STORAGE_ENDPOINT_URL=https://s3.example.com
# STORAGE_VERIFICATION_BUCKET=private-verification
# STORAGE_REGION=region-1
# STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
# STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
